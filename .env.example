# Public application URL used in profile links, vCards, QR output, and metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Hostnames/IPs used to access the Next.js dev server from another device.
NEXT_ALLOWED_DEV_ORIGINS=localhost,127.0.0.1

# Keep local development self-contained until a Convex deployment is configured.
NEXT_PUBLIC_DEMO_MODE=true
# Optional hosted demo storage. Set to convex only with a shared non-production deployment.
# Hosted demo data is shared and must never use production Convex data.
# NEXT_PUBLIC_DEMO_STORAGE=convex
# Runtime label returned by the non-production live-target check; use preview for a preview deployment.
TAPIT_APP_ENV=development
# Live mode is opt-in only. For development live or preview, set this to false
# and align NEXT_PUBLIC_CONVEX_URL with the explicitly selected CONVEX_DEPLOYMENT.
# Production values are configured only in the approved production environment,
# never in this example file.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
# Comma-separated exact origins accepted by the authenticated image upload route.
TAPIT_ALLOWED_ORIGINS=http://localhost:3000

# Convex/Auth values are deployment-specific. Never commit real secrets.
CONVEX_DEPLOYMENT=dev:your-deployment
AUTH_SECRET=replace-with-a-local-secret
TAPIT_SUPPORT_URL=https://support.example.test
# Live E2E is a separate, non-production contract. Keep these values in ignored
# environment storage; see docs/live-e2e.md for Google storage-state provisioning
# and the required explicit confirmation before provisioning.
# Run with: npm run test:e2e:live
# Required live variables are listed in docs/live-e2e.md; never make live mode
# the default in this file.

# Safe local support destination; replace for preview/production after the support gate.
NEXT_PUBLIC_SUPPORT_URL=mailto:support@example.test

# Live deployments configure Google OAuth and the first-admin allowlist in Convex:
# AUTH_GOOGLE_ID, AUTH_GOOGLE_SECRET, and TAPIT_ADMIN_EMAILS.
